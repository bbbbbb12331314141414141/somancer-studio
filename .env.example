# Sonmancer Studio — Environment Configuration

# ============================================================================
# Backend (FastAPI)
# ============================================================================

# Database connection string
# SQLite (development): sqlite:///./sonmancer.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/sonmancer
DATABASE_URL=sqlite:///./sonmancer.db

# Ollama API endpoint
OLLAMA_HOST=http://localhost:11434

# Seconds to wait for a single generation. Local CPU inference is slow —
# a composer request emitting ~50 notes of JSON can take several minutes
# with a 7B model. Raise this if you see 504 responses.
OLLAMA_TIMEOUT=600

# Logging level
LOG_LEVEL=INFO

# Environment (development, staging, production)
ENVIRONMENT=development

# Backend server host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ============================================================================
# Frontend (Tauri + React)
# ============================================================================

# API base URL
VITE_API_URL=http://localhost:8000

# Environment
VITE_ENVIRONMENT=development

# ============================================================================
# Audio Configuration
# ============================================================================

# Default sample rate (Hz)
AUDIO_SAMPLE_RATE=48000

# Default bit depth
AUDIO_BIT_DEPTH=24

# Audio buffer size (samples)
AUDIO_BUFFER_SIZE=2048

# ============================================================================
# GPU Support
# ============================================================================

# Enable CUDA GPU acceleration (true/false)
CUDA_ENABLED=false

# GPU memory limit (GB)
GPU_MEMORY_GB=8

# ============================================================================
# AI/Ollama Models
# ============================================================================

# Default text model for lyrics/composition
DEFAULT_TEXT_MODEL=mistral

# Default voice model (if using voice synthesis)
DEFAULT_VOICE_MODEL=

# Temperature for model inference (0.0-2.0, higher = more creative)
MODEL_TEMPERATURE=0.7

# Top-p (nucleus sampling) for model inference (0.0-1.0)
MODEL_TOP_P=0.9

# ============================================================================
# File Paths
# ============================================================================

# Project storage directory
PROJECTS_DIR=./projects

# Audio export directory
EXPORTS_DIR=./exports

# Temporary files directory
TEMP_DIR=./tmp

# SoundFont directory (SF2 files)
SOUNDFONT_DIR=./soundfonts

# ============================================================================
# Feature Flags (Phase 0+)
# ============================================================================

# Enable AI features
ENABLE_AI=true

# Enable audio rendering
ENABLE_AUDIO=true

# Enable plugin support
ENABLE_PLUGINS=true

# ── Web research (opt-in) ─────────────────────────────────────────────────────
# Sonmancer is offline-first. This is OFF by default.
#
# When enabled, genre research is grounded in retrieved sources instead of the
# model's recollection — which matters a lot for obscure genres, where an
# ungrounded model will invent plausible-sounding BPM ranges and instruments.
#
# Only genre NAMES are ever sent outward. Never project data, lyrics, or audio.
ENABLE_WEB_RESEARCH=false

# Default providers need no API key:
#   Wikipedia    — genre prose (CC BY-SA, cited in results)
#   MusicBrainz  — genre taxonomy (rate-limited to 1 req/sec by their terms)

# Optional: self-hosted SearXNG for private meta-search
SEARX_URL=

# Freesound — recorded samples for textures a soundfont cannot give you.
# Free key: freesound.org/apiv2/apply. Optional; the soundfont index works
# with no key and no network.
FREESOUND_API_KEY=

# Optional: any JSON search API taking a bearer token (Tavily, Brave, Serper)
SEARCH_API_URL=
SEARCH_API_KEY=

# Seconds to wait for all research providers combined
RESEARCH_TIMEOUT=15

# Enable cloud sync (future)
ENABLE_CLOUD=false

# ============================================================================
# Development Only
# ============================================================================

# Enable debug logging
DEBUG=false

# Enable mock Ollama (for frontend testing without real Ollama)
MOCK_OLLAMA=false

# Enable hot reload in backend
BACKEND_RELOAD=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

# ============================================================================
# Optional: Remote Services (Phase 1+)
# ============================================================================

# Anthropic API key (for optional Claude integration)
ANTHROPIC_API_KEY=

# OpenAI API key (for optional ChatGPT integration)
OPENAI_API_KEY=

# Suno API key (for optional Suno integration)
SUNO_API_KEY=

# ── Neural audio synthesis (optional) ─────────────────────────────────────────
# Requires: pip install "sonmancer-backend[neural]"  (~2 GB + model weights)
#
# Weights download once then run locally. Set OFFLINE=1 to forbid network use.
# HF_HOME=/path/to/model/cache
# HF_HUB_OFFLINE=0
#
# Required for gated models (Stable Audio Open):
# HF_TOKEN=

# Apple Silicon: allow CPU fallback for unsupported Metal ops
# PYTORCH_ENABLE_MPS_FALLBACK=1
